    stroke(track,default and C.Accent or Color3.fromRGB(52,42,82),1)
    local knob=frame(track,UDim2.new(0,18,0,18),default and UDim2.new(1,-21,0,3) or UDim2.new(0,3,0,3),default and C.AccentLt or C.TextDim,9)
    local tBtn=Instance.new("TextButton"); tBtn.Size=UDim2.new(1,0,1,0); tBtn.BackgroundTransparency=1; tBtn.Text=""; tBtn.ZIndex=5; tBtn.Parent=row
    local state=default or false; local callbacks={}
    local function setVis(s)
        TweenService:Create(knob,TweenInfo.new(0.18),{Position=s and UDim2.new(1,-21,0,3) or UDim2.new(0,3,0,3)}):Play()
        TweenService:Create(knob,TweenInfo.new(0.18),{BackgroundColor3=s and C.AccentLt or C.TextDim}):Play()
        TweenService:Create(track,TweenInfo.new(0.18),{BackgroundColor3=s and C.AccentDk or Color3.fromRGB(36,30,58)}):Play()
        statusLbl.Text=s and "ON" or "OFF"; statusLbl.TextColor3=s and C.Green or C.Red
    end
    tBtn.MouseButton1Click:Connect(function() state=not state; setVis(state); for _,cb in ipairs(callbacks) do cb(state) end end)
    return row,tBtn,function() return state end,function(s) state=s; setVis(s) end,function(cb) table.insert(callbacks,cb) end
end

