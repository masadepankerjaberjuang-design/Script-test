    local cleanId=tostring(id):match("%d+") or id
    anim.AnimationId="rbxassetid://"..cleanId
    local ok,track=pcall(function() return animator:LoadAnimation(anim) end)
    if ok and track then track:Play(); currentAnimTrack=track; notify("Animation","Playing: "..cleanId,C.Glow)
    else notify("Anim Error","Invalid ID or no permission",C.Red) end
    anim:Destroy()
end

