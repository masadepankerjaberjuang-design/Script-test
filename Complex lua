-- ============================================================
local function playReworkSkill()
    if S.ReworkActive then return end
    local char=getChar(); local hrp=getHRP(); local hum=getHum()
    if not char or not hrp or not hum then notify("Skill","No character!",C.Red); return end
    S.ReworkActive=true; reworkBtn.Text="⏳  CD..."; reworkCdLbl.Text="Active"; reworkCdLbl.TextColor3=C.Orange

    local topBar=frame(SG,UDim2.new(1,0,0,60),UDim2.new(0,0,0,-60),C.Black,0); topBar.ZIndex=160
    local botBar=frame(SG,UDim2.new(1,0,0,60),UDim2.new(0,0,1,0),C.Black,0); botBar.ZIndex=160
    TweenService:Create(topBar,TweenInfo.new(0.35,Enum.EasingStyle.Quad),{Position=UDim2.new(0,0,0,0)}):Play()
    TweenService:Create(botBar,TweenInfo.new(0.35,Enum.EasingStyle.Quad),{Position=UDim2.new(0,0,1,-60)}):Play()
    local skillLbl=lbl(SG,"",UDim2.new(1,0,0,58),UDim2.new(0,0,0.41,0),0,Enum.Font.GothamBold,C.White)
    skillLbl.TextStrokeTransparency=0.2; skillLbl.ZIndex=162
    task.wait(0.38)
    local bg=Instance.new("BodyGyro"); bg.MaxTorque=Vector3.new(9e4,9e4,9e4); bg.P=5000; bg.CFrame=hrp.CFrame; bg.Parent=hrp
    local bv=Instance.new("BodyVelocity"); bv.MaxForce=Vector3.new(9e4,9e4,9e4); bv.Velocity=Vector3.zero; bv.Parent=hrp
    local function sp(txt,size,pos,col,dur,ep)
        local p=lbl(SG,txt,UDim2.new(0,size,0,size),pos,size,Enum.Font.GothamBold,col or C.White)
        p.BackgroundTransparency=1; p.ZIndex=165
        TweenService:Create(p,TweenInfo.new(dur,Enum.EasingStyle.Quad),{Position=ep or p.Position+UDim2.new(0,0,-0.08,0),TextTransparency=1}):Play()
        task.delay(dur+0.05,function() p:Destroy() end)
    end
    -- Phase 1
    skillLbl.Text="⚡  CHARGING..."; skillLbl.TextColor3=Color3.fromRGB(255,220,60)
    TweenService:Create(skillLbl,TweenInfo.new(0.2,Enum.EasingStyle.Back),{TextSize=32}):Play()
    for i=1,5 do task.spawn(function()
        task.wait(i*0.08)
        local ring=lbl(SG,"◯",UDim2.new(0,40,0,40),UDim2.new(0.5,-20,0.5,-20),40+i*8,Enum.Font.GothamBold,Color3.fromRGB(255,220,60))
        ring.BackgroundTransparency=1; ring.ZIndex=163
        TweenService:Create(ring,TweenInfo.new(0.5),{Size=UDim2.new(0,120+i*20,0,120+i*20),Position=UDim2.new(0.5,-60-i*10,0.5,-60-i*10),TextTransparency=1}):Play()
        task.delay(0.55,function() ring:Destroy() end)
    end) end
    local cOv=frame(SG,UDim2.new(1,0,1,0),nil,Color3.fromRGB(255,220,60),0); cOv.BackgroundTransparency=0.88; cOv.ZIndex=164
    task.wait(0.55)
    -- Phase 2
    TweenService:Create(skillLbl,TweenInfo.new(0.15),{TextSize=10}):Play(); task.wait(0.18)
    skillLbl.Text="↑  JUMP!!"; skillLbl.TextColor3=Color3.fromRGB(100,210,255)
    TweenService:Create(skillLbl,TweenInfo.new(0.22,Enum.EasingStyle.Back),{TextSize=42}):Play()
    TweenService:Create(cOv,TweenInfo.new(0.2),{BackgroundTransparency=1}):Play()
    task.delay(0.22,function() cOv:Destroy() end)
    bv.Velocity=Vector3.new(0,95,0); bg.CFrame=CFrame.new(hrp.Position,hrp.Position+Cam.CFrame.LookVector)
    for i=1,6 do sp("✨",14+i*3,UDim2.new(0.5+math.random(-20,20)/100,0,0.5+math.random(-15,15)/100,0),Color3.fromRGB(100,210,255),0.7+i*0.05) end
    task.wait(0.6); bv.Velocity=Vector3.zero; task.wait(0.2)
    -- Phase 3
    TweenService:Create(skillLbl,TweenInfo.new(0.12),{TextSize=8}):Play(); task.wait(0.14)
    skillLbl.Text="🚀  FLY!!"; skillLbl.TextColor3=Color3.fromRGB(255,200,50)
    TweenService:Create(skillLbl,TweenInfo.new(0.2,Enum.EasingStyle.Back),{TextSize=46}):Play()
    bv.Velocity=Cam.CFrame.LookVector*95+Vector3.new(0,22,0); bg.CFrame=CFrame.new(hrp.Position,hrp.Position+Cam.CFrame.LookVector)
    for i=1,5 do sp("★",12,UDim2.new(0.5+math.random(-30,30)/100,0,0.5+math.random(-20,20)/100,0),Color3.fromRGB(255,200,50),0.6+i*0.08) end
    task.wait(0.95); bv.Velocity=Vector3.zero; task.wait(0.18)
    -- Phase 4
    TweenService:Create(skillLbl,TweenInfo.new(0.1),{TextSize=8}):Play(); task.wait(0.12)
    skillLbl.Text="💥  SUPER PUNCH!!"; skillLbl.TextColor3=C.Red
    TweenService:Create(skillLbl,TweenInfo.new(0.18,Enum.EasingStyle.Back),{TextSize=52}):Play()
    local pG=frame(SG,UDim2.new(1,0,1,0),nil,C.Red,0); pG.BackgroundTransparency=0.82; pG.ZIndex=164
    TweenService:Create(pG,TweenInfo.new(0.22),{BackgroundTransparency=0.6}):Play(); task.wait(0.24)
    bv.Velocity=Cam.CFrame.LookVector*200
    local wF=frame(SG,UDim2.new(1,0,1,0),nil,C.White,0); wF.BackgroundTransparency=0; wF.ZIndex=166
    TweenService:Create(wF,TweenInfo.new(0.4),{BackgroundTransparency=1}):Play()
    task.delay(0.45,function() wF:Destroy() end)
    TweenService:Create(pG,TweenInfo.new(0.45),{BackgroundTransparency=1}):Play()
    task.delay(0.5,function() pG:Destroy() end)
    local boom=lbl(SG,"💥",UDim2.new(0,55,0,55),UDim2.new(0.5,-27,0.5,-27),55); boom.ZIndex=167; boom.BackgroundTransparency=1
    TweenService:Create(boom,TweenInfo.new(0.6),{Size=UDim2.new(0,220,0,220),Position=UDim2.new(0.5,-110,0.5,-110),TextTransparency=1}):Play()
    task.delay(0.65,function() boom:Destroy() end)
    for i=1,5 do task.spawn(function()
        task.wait(i*0.06)
        local r=lbl(SG,"◯",UDim2.new(0,30,0,30),UDim2.new(0.5,-15,0.5,-15),30,Enum.Font.GothamBold,Color3.fromRGB(255,80+i*25,40))
        r.BackgroundTransparency=1; r.ZIndex=166
        TweenService:Create(r,TweenInfo.new(0.55),{Size=UDim2.new(0,60+i*70,0,60+i*70),Position=UDim2.new(0.5,-(30+i*35),0.5,-(30+i*35)),TextTransparency=1}):Play()
        task.delay(0.6,function() r:Destroy() end)
    end) end
    task.wait(0.2); bv.Velocity=Vector3.zero; task.wait(0.65)
    -- Cleanup
    TweenService:Create(skillLbl,TweenInfo.new(0.3),{TextTransparency=1,TextSize=8}):Play()
    TweenService:Create(topBar,TweenInfo.new(0.32),{Position=UDim2.new(0,0,0,-60)}):Play()
    TweenService:Create(botBar,TweenInfo.new(0.32),{Position=UDim2.new(0,0,1,0)}):Play()
    task.wait(0.35); skillLbl:Destroy(); topBar:Destroy(); botBar:Destroy(); bv:Destroy(); bg:Destroy()
    local cd=10
    for i=cd,1,-1 do reworkCdLbl.Text="CD: "..i.."s"; task.wait(1) end
    S.ReworkActive=false; reworkBtn.Text="💀  REWORK"; reworkCdLbl.Text="Ready!"; reworkCdLbl.TextColor3=C.Green
    notify("Skill","💀 Death Rework ready!",C.Accent)
end

