        minBtn.Text="+"
    else
        refreshWindowSize()
        task.wait(); local h=MW.Size.Y.Offset
        TweenService:Create(MW,TweenInfo.new(0.28,Enum.EasingStyle.Back),{Size=UDim2.new(0,380,0,h)}):Play()
        minBtn.Text="–"
    end
end)
