-- GUI HELPERS
local function corner(p,r) local u=Instance.new("UICorner"); u.CornerRadius=UDim.new(0,r or 8); u.Parent=p; return u end
local function stroke(p,col,th) local s=Instance.new("UIStroke"); s.Color=col or C.Accent; s.Thickness=th or 1.5; s.ApplyStrokeMode=Enum.ApplyStrokeMode.Border; s.Parent=p; return s end
local function frame(parent,size,pos,bg,r)
    local f=Instance.new("Frame"); f.Size=size; f.Position=pos or UDim2.new(0,0,0,0)
    f.BackgroundColor3=bg or C.BG1; f.BorderSizePixel=0; f.Parent=parent
    if r then corner(f,r) end; return f
end
local function lbl(parent,txt,size,pos,fs,font,col,ax)
    local l=Instance.new("TextLabel"); l.Text=txt; l.Size=size; l.Position=pos or UDim2.new(0,0,0,0)
    l.BackgroundTransparency=1; l.TextColor3=col or C.Text; l.TextSize=fs or 13
    l.Font=font or Enum.Font.Gotham; l.TextXAlignment=ax or Enum.TextXAlignment.Center
    l.TextScaled=false; l.Parent=parent; return l
end
local function btn(parent,txt,size,pos,bg,tc,fs)
    local b=Instance.new("TextButton"); b.Text=txt; b.Size=size; b.Position=pos or UDim2.new(0,0,0,0)
    b.BackgroundColor3=bg or C.BG2; b.TextColor3=tc or C.Text; b.TextSize=fs or 13
    b.Font=Enum.Font.GothamBold; b.BorderSizePixel=0; b.AutoButtonColor=false; b.Parent=parent
    corner(b,8); return b
end
local function hover(b,n,h)
    b.MouseEnter:Connect(function() TweenService:Create(b,TweenInfo.new(0.15),{BackgroundColor3=h}):Play() end)
    b.MouseLeave:Connect(function() TweenService:Create(b,TweenInfo.new(0.15),{BackgroundColor3=n}):Play() end)
end

